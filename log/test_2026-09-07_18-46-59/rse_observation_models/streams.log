[1.325s] 	def observation_model(particles, z, Q):
[1.325s] 		# Calculate the error between the measured pose and each particle's pose
[1.325s] 		error = particles - z
[1.325s] 		
[1.325s] 		# Handle angle wrapping for the heading error. This is crucial.
[1.325s] 		# We subtract the angles and then wrap the result to the [-pi, pi] range.
[1.325s] 		error[:, 2] = (error[:, 2] - z[2] + np.pi) % (2 * np.pi) - np.pi
[1.325s] 		
[1.325s] 		# Calculate the likelihood of the error using a multivariate normal PDF.
[1.325s] 		# The mean of the error is [0, 0, 0].
[1.325s] 		# This gives a high likelihood to particles with low error.
[1.325s] 		likelihood = scipy.stats.multivariate_normal(mean=np.zeros(8), cov=Q).pdf(error)
[1.325s] 
