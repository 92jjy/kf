<?xml version="1.0"?>
<sdf version="1.6">
  <world name="test_world">

    <!-- Gravity (m/s^2) -->
    <gravity>0 0 -9.81</gravity>

    <!-- Environment lighting / scene -->
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.7 0.7 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Physics engine (ODE) -->
    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>200</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- Perimeter walls to give the lidar something to see -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 6 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>12 0.2 1</size></box></geometry></visual>
        <collision name="collision"><geometry><box><size>12 0.2 1</size></box></geometry></collision>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -6 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>12 0.2 1</size></box></geometry></visual>
        <collision name="collision"><geometry><box><size>12 0.2 1</size></box></geometry></collision>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>6 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>12 0.2 1</size></box></geometry></visual>
        <collision name="collision"><geometry><box><size>12 0.2 1</size></box></geometry></collision>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-6 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>12 0.2 1</size></box></geometry></visual>
        <collision name="collision"><geometry><box><size>12 0.2 1</size></box></geometry></collision>
      </link>
    </model>

    <!-- Obstacle boxes -->
    <model name="box1">
      <static>true</static>
      <pose>2.5 1.5 0.4 0 0 0.5</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.2 0.8 0.8</size></box></geometry>
          <material><ambient>0.8 0.3 0.1 1</ambient></material>
        </visual>
        <collision name="collision"><geometry><box><size>1.2 0.8 0.8</size></box></geometry></collision>
      </link>
    </model>
    <model name="box2">
      <static>true</static>
      <pose>-2.5 -2 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material><ambient>0.1 0.6 0.3 1</ambient></material>
        </visual>
        <collision name="collision"><geometry><box><size>1 1 1</size></box></geometry></collision>
      </link>
    </model>
    <model name="box3">
      <static>true</static>
      <pose>-2 3 0.4 0 0 -0.8</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.5 0.6 0.8</size></box></geometry>
          <material><ambient>0.5 0.1 0.7 1</ambient></material>
        </visual>
        <collision name="collision"><geometry><box><size>1.5 0.6 0.8</size></box></geometry></collision>
      </link>
    </model>

  </world>
</sdf>
